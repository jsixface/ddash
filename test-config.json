                                                                "Referrer-Policy": null,
                                                                "X-XSS-Protection": null
                                                            }
                                                        },
                                                        "set": {
                                                            "Content-Security-Policy": [
                                                                "default-src 'self' data: blob: *.wcpgw.in *.sixface.in; \n\t\t\t\t\t\t\t\t\tstyle-src 'self' 'unsafe-inline'; \n\t\t\t\t\t\t\t\t\tscript-src 'self' 'unsafe-inline' blob:; \n\t\t\t\t\t\t\t\t\tworker-src 'self' blob:; \n\t\t\t\t\t\t\t\t\tconnect-src 'self'; \n\t\t\t\t\t\t\t\t\tobject-src 'none'; \n\t\t\t\t\t\t\t\t\tframe-ancestors 'self'"
                                                            ],
                                                            "Referrer-Policy": [
                                                                "no-referrer"
                                                            ],
                                                            "X-Xss-Protection": [
                                                                "1; mode=block"
                                                            ]
