                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "headers",
                                                    "response": {
                                                        "set": {
                                                            "Strict-Transport-Security": [
                                                                "max-age=31536000;"
                                                            ]
                                                        }
                                                    }
                                                }
                                            ],
