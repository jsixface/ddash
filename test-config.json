                                        "budget.home"
                                    ]
                                }
                            ],
                            "terminal": true
                        }
                    ],
                    "tls_connection_policies": [
                        {
                            "certificate_selection": {
                                "any_tag": [
                                    "cert0"
                                ]
                            },
                            "match": {
                                "sni": [
                                    "budget.home"
                                ]
                            }
                        },
                        {}
                    ]
